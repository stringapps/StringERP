### Create Sales Order with partial advance payment (500 of total)
### Each payments[] line becomes its own Payment Entry. Omit payments and set ispaid=1 to pay in full.
POST http://127.0.0.1:8002/api/method/stringerp.v1.api.create_siv
Content-Type: application/json
Authorization: token 1b5308bc9d3b9cd:92bcf1657e90fce

{
  "firstName": "Walkin Customer",
  "customercode": "Walkin Customer",
  "address1": "",
  "guid": "SO-TEST-0001",
  "salesmancode": "",
  "ordertype": "Order",
  "SubTotalDiscount": 0,
  "ispaid": 0,
  "CRTime": "2026-11-14 10:00:00",
  "Remarks": "",
  "customerOrdernumber": "BTS-SO-0001",
  "items": [
    {
      "barcode": "BT0023",
      "quantity": 10,
      "UnitPrice": 100,
      "rate": 100,
      "UnitDisc": 0,
      "DiscTID": "DINE IN"
    }
  ],
  "payments": [
    { "CARDTYPE": "CASH", "CARDNO": "", "AMOUNT": 300 },
    { "CARDTYPE": "VISA", "CARDNO": "4111", "AMOUNT": 200 }
  ],
  "deliveryCharges": []
}


### Create Sales Invoice for an existing Sales Order (soName)
### Links items to the order and applies its advance payments; send only the balance in payments[].
### Omit soName for an independent invoice.
POST http://127.0.0.1:8002/api/method/stringerp.v1.api.create_siv
Content-Type: application/json
Authorization: token 1b5308bc9d3b9cd:92bcf1657e90fce

{
  "ordertype": "Invoice",
  "soName": "SAL-ORD-2026-00012",
  "guid": "INV-SO-TEST-0001",
  "customerOrdernumber": "BTS-INV-SO-0001",
  "customercode": "Walkin Customer",
  "salesmancode": "",
  "posProfile": "TAWOOK-SEEF",
  "CRTime": "2026-11-15 10:00:00",
  "billDate": "2026-11-15 10:00:00",
  "ispaid": 1,
  "Reupload": 0,
  "items": [
    { "barcode": "BT0023", "quantity": 10, "UnitPrice": 100, "rate": 100, "UnitDisc": 0, "DiscTID": "DINE IN" }
  ],
  "payments": [
    { "CARDTYPE": "CASH", "CARDNO": "", "AMOUNT": 650 }
  ],
  "deliveryCharges": []
}


### Cancel Sales Order (also cancels its linked Payment Entries)
### Send ONE of: sales_order | guid | customerOrdernumber
POST http://127.0.0.1:8002/api/method/stringerp.v1.api.cancel_sales_order
Content-Type: application/json
Authorization: token 1b5308bc9d3b9cd:92bcf1657e90fce

{
  "customerOrdernumber": "BTS-SO-0001"
}


### Add a later (part / split) payment to an existing Sales Order
### Send ONE of: sales_order | guid | customerOrdernumber
### payments[]: one Payment Entry per line (CARDTYPE = mode of payment, CARDNO = reference no)
### payment_guid: optional, unique per POS payment; retrying it returns the original entries (duplicate=true)
### Total paid on the order can never exceed its grand total
POST http://127.0.0.1:8002/api/method/stringerp.v1.api.add_sales_order_payment
Content-Type: application/json
Authorization: token 1b5308bc9d3b9cd:92bcf1657e90fce

{
  "customerOrdernumber": "BTS-SO-0001",
  "payment_guid": "BTS-PAY-0002",
  "posting_date": "2026-11-22",
  "payments": [
    { "CARDTYPE": "CASH", "AMOUNT": 200, "CARDNO": "" },
    { "CARDTYPE": "CARD", "AMOUNT": 300, "CARDNO": "TXN-88231" }
  ]
}


### Refund a cancelled Sales Order (new "Pay" Payment Entry to the customer)
### Send ONE of: sales_order | guid | customerOrdernumber
### refund_amount: required, > 0, max = amount paid on the order minus earlier refunds
### mode_of_payment: optional (default: company cash account)
### reference_no: optional (default: Sales Order name)
POST http://127.0.0.1:8002/api/method/stringerp.v1.api.refund_sales_order
Content-Type: application/json
Authorization: token 1b5308bc9d3b9cd:92bcf1657e90fce

{
  "customerOrdernumber": "BTS-SO-0001",
  "refund_amount": 400,
  "mode_of_payment": "CASH",
  "reference_no": ""
}
